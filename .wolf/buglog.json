      "id": "bug-001",
      "timestamp": "2026-08-29T04:50:00Z",
      "error_message": "RuntimeError: maker crashed (red-team attack 1: crashed maker)",
      "file": "goal_loop/loop_runner.py",
      "root_cause": "GoalLoopRunner.run() called self._maker() without catching exceptions, so a crashing maker propagated and killed the loop (goal stuck active, neither blocked nor complete).",
      "fix": "Wrap maker call in try/except; on exception return MakerOutput(ok=False) so the round counts as no-progress and the three-strike audit blocks the goal.",
      "tags": [
        "fail-closed",
        "maker",
        "exception",
        "loop"
      ],
      "related_bugs": [
        "bug-002"
      ],
      "occurrences": 1,
      "last_seen": "2026-08-29T04:50:00Z"
    },
